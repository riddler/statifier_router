{
  "id": "click-then-orphan-timeout",
  "description": "A click whose impression never comes: after an hour the orphan timer fires, the orphan reaches dead_letter, and after the grace period the execution finishes.",
  "document": "impression_click_join",
  "scope": "7c1e",
  "routes": ["joined_records", "dead_letter"],
  "bindings": [
    {
      "id": "impressions_to_join",
      "source": "ad_events",
      "match": "event.kind == 'impression'",
      "key": "event.impression_id",
      "document": "impression_click_join",
      "event": "impression",
      "data": ["impression_id", "shown_at", "placement"]
    },
    {
      "id": "clicks_to_join",
      "source": "ad_events",
      "match": "event.kind == 'click'",
      "key": "event.impression_id",
      "document": "impression_click_join",
      "event": "click",
      "data": ["impression_id", "clicked_at", "url"]
    }
  ],
  "script": [
    {"deliver": {"source": "ad_events", "message_id": "ad_events/4/2291", "data": {"kind": "click", "impression_id": "imp_d318", "clicked_at": "2026-09-19T08:00:00Z", "url": "https://example.com/offer"}}},
    {"advance": "PT2H"}
  ],
  "expected": {
    "ledger": [
      {"binding": "clicks_to_join", "message_id": "ad_events/4/2291", "outcome": "created_and_delivered", "key": "imp_d318"}
    ],
    "status": "completed",
    "configuration": [],
    "timers": [],
    "sends": [
      {"route": "dead_letter", "event": {"name": "orphaned", "data": {"impression_id": "imp_d318"}}}
    ],
    "datamodel": {"late_clicks": []}
  }
}
