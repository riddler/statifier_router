<?xml version="1.0" encoding="UTF-8"?>
<!--
  The impression / click left outer join: one execution per impression_id.

  An impression waits 24 hours for its click; a click waits 1 hour for its
  impression. Either way the execution then holds a 1 hour grace period, in
  the state closed, before it finishes in done.

  The join hands its result out as a send rather than keeping it: a
  completed join reaches the route joined_records, and a click no
  impression joined - a click whose hour ran out, an impression whose
  window closed, and a click that arrives once the join has closed -
  reaches dead_letter. Each names the host's send type in type and the
  route name in target, which is how ADR-0005 spells an outbound send. A
  click that arrives during the grace period is also appended to
  late_clicks, which is what the execution still holds rather than a
  result it hands out.

  The timers are the host's: every delay below reaches the host as a
  delayed send, carrying no target, and a cancel as a cancel.
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="predicator" initial="empty">
  <datamodel>
    <data id="impression_id" expr="null"/>
    <data id="late_clicks" expr="[]"/>
  </datamodel>

  <state id="empty">
    <transition event="impression" target="awaiting_click">
      <assign location="impression_id" expr="_event.data.impression_id"/>
    </transition>
    <transition event="click" target="awaiting_impression">
      <assign location="impression_id" expr="_event.data.impression_id"/>
    </transition>
  </state>

  <state id="awaiting_click">
    <onentry>
      <send id="window" event="window.closed" delay="24h"/>
    </onentry>
    <transition event="click" target="joined"/>
    <transition event="window.closed" target="expired"/>
  </state>

  <state id="awaiting_impression">
    <onentry>
      <send id="orphan" event="orphan.timeout" delay="1h"/>
    </onentry>
    <transition event="impression" target="joined"/>
    <transition event="orphan.timeout" target="closed">
      <send type="myapp:sink" target="dead_letter" event="orphaned">
        <param name="impression_id" expr="impression_id"/>
      </send>
    </transition>
  </state>

  <state id="joined">
    <onentry>
      <cancel sendid="window"/>
      <cancel sendid="orphan"/>
      <send type="myapp:sink" target="joined_records" event="joined">
        <param name="impression_id" expr="impression_id"/>
      </send>
    </onentry>
    <transition target="closed"/>
  </state>

  <state id="expired">
    <onentry>
      <send type="myapp:sink" target="dead_letter" event="expired">
        <param name="impression_id" expr="impression_id"/>
      </send>
    </onentry>
    <transition target="closed"/>
  </state>

  <state id="closed">
    <onentry>
      <send id="grace" event="grace.over" delay="1h"/>
    </onentry>
    <transition event="click">
      <assign location="late_clicks" expr="concat(late_clicks, [_event.data])"/>
      <send type="myapp:sink" target="dead_letter" event="late_click">
        <param name="impression_id" expr="impression_id"/>
        <param name="click" expr="_event.data"/>
      </send>
    </transition>
    <transition event="impression"/>
    <transition event="grace.over" target="done"/>
  </state>

  <final id="done"/>
</scxml>
