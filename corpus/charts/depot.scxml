<?xml version="1.0" encoding="UTF-8"?>
<!--
  The depot's handling of a parcel a courier brings back: the sending
  document of the publish cases.

  When the courier reports that nobody was home, the depot tells the
  parcel's own execution that it has been returned. The send writes the
  host's send type in type and the reserved execution target in target,
  and names the receiving document and the parcel's key as params, which
  is how ADR-0006 spells a send from one execution to another. Its event,
  parcel.returned, is a literal, so the receiver contract at publish can
  judge it (ADR-0008).
-->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0"
       datamodel="predicator" initial="sorting">
  <state id="sorting">
    <transition event="courier.nobody_home" target="returning">
      <send type="myapp:sink" target="execution" event="parcel.returned">
        <param name="document" expr="'parcel'"/>
        <param name="key" expr="_event.data.parcel_id"/>
      </send>
    </transition>
  </state>

  <final id="returning"/>
</scxml>
